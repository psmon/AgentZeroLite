<UserControl x:Class="AgentZeroWpf.UI.Components.RemotePagePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource EditorBg}">
    <!--
        Remote — the web terminal-control panel.
        Settings (port / max connections / binding / enabled) and live control (start and
        stop the server, issue a one-time PIN, active connections, revoke a pairing
        token) on one screen.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Header -->
            <RowDefinition Height="Auto"/>  <!-- 1: LAN warning -->
            <RowDefinition Height="*"/>     <!-- 2: Content (scroll) -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBg}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="btnClose" Content="✕"
                        Style="{DynamicResource FlatButton}" FontSize="13"
                        ToolTip="Close" Click="OnCloseClick"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource CyberCyanBrush}"
                               FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Remote — Web Terminal" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- LAN warning banner -->
        <Border Grid.Row="1" Background="#3A1D1D" BorderBrush="#7A2E2E" BorderThickness="1"
                Padding="12,8" Margin="10,10,10,0" CornerRadius="4">
            <TextBlock TextWrapping="Wrap" Foreground="#F0A0A0" FontSize="12">
                ⚠ This lets anything on the network drive this PC's terminals — remote execution, in effect.
                The default binding is <Run FontWeight="Bold">0.0.0.0 (the whole LAN)</Run>.
                Use it only on a network you trust, and do not share the pairing code.
            </TextBlock>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="10">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                <!-- Config -->
                <TextBlock Text="Settings" FontWeight="Bold" Foreground="{DynamicResource CyberCyanBrush}"
                           FontSize="12" Margin="0,6,0,6"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.ColumnSpan="2" x:Name="chkEnabled"
                              Content="Start the Remote server on launch"
                              Foreground="{DynamicResource TextPrimary}" Margin="0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Bind address"
                               Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cboBind" Width="200"
                              HorizontalAlignment="Left" Margin="0,4">
                        <ComboBoxItem Content="0.0.0.0 (whole LAN)"/>
                        <ComboBoxItem Content="127.0.0.1 (this PC only)"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Port"
                               Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtPort" Width="120"
                             HorizontalAlignment="Left" Style="{DynamicResource DarkTextBox}" Margin="0,4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Max concurrent connections"
                               Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtMaxConn" Width="120"
                             HorizontalAlignment="Left" Style="{DynamicResource DarkTextBox}" Margin="0,4"/>
                </Grid>
                <Button x:Name="btnSaveApply" Content="Save &amp; apply"
                        Style="{DynamicResource AccentButton}" Padding="14,5"
                        HorizontalAlignment="Left" Click="OnSaveApplyClick"/>

                <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,16"/>

                <!-- Server status -->
                <TextBlock Text="Server" FontWeight="Bold" Foreground="{DynamicResource CyberCyanBrush}"
                           FontSize="12" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Status:" Foreground="{DynamicResource TextDim}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="txtStatus" Text="Stopped" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold"/>
                    <TextBlock Text="  Connections:" Foreground="{DynamicResource TextDim}" Margin="16,0,6,0"/>
                    <TextBlock x:Name="txtConnCount" Text="0 / 3" Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Address:" Foreground="{DynamicResource TextDim}" Margin="0,0,6,0"/>
                    <TextBox x:Name="txtUrl" Text="—" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" Foreground="{DynamicResource CyberMintBrush}"/>
                </StackPanel>
                <TextBlock x:Name="txtError" Text="" Foreground="#F0A0A0" TextWrapping="Wrap"
                           FontSize="11" Margin="0,0,0,6" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnStart" Content="▶ Start" Style="{DynamicResource FlatButton}"
                            Padding="12,5" Click="OnStartClick"/>
                    <Button x:Name="btnStop" Content="■ Stop" Style="{DynamicResource FlatButton}"
                            Padding="12,5" Margin="6,0,0,0" Click="OnStopClick"/>
                    <Button x:Name="btnRefresh" Content="↻ Refresh" Style="{DynamicResource FlatButton}"
                            Padding="12,5" Margin="6,0,0,0" Click="OnRefreshClick"/>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,16"/>

                <!-- Pairing -->
                <TextBlock Text="Pairing code (one-time PIN)" FontWeight="Bold"
                           Foreground="{DynamicResource CyberCyanBrush}" FontSize="12" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,0,0,8">
                    Open the address above in a browser, then enter this code to pair.
                    The code is valid for five minutes and can be used once.
                </TextBlock>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnIssuePin" Content="Issue code" Style="{DynamicResource AccentButton}"
                            Padding="14,5" Click="OnIssuePinClick"/>
                    <TextBlock x:Name="txtPin" Text="————" FontFamily="Consolas" FontSize="24"
                               FontWeight="Bold" Foreground="{DynamicResource CyberYellowBrush}"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBlock x:Name="txtPinExpiry" Text="" Foreground="{DynamicResource TextDim}"
                               FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,16"/>

                <!-- Paired tokens -->
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" x:Name="btnRevokeAll" Content="Revoke all"
                            Style="{DynamicResource FlatButton}" FontSize="11"
                            Click="OnRevokeAllClick"/>
                    <TextBlock Text="Paired devices" FontWeight="Bold"
                               Foreground="{DynamicResource CyberCyanBrush}" FontSize="12"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel x:Name="pnlTokens"/>
                <TextBlock x:Name="txtNoTokens" Text="No paired devices."
                           Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,4"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
