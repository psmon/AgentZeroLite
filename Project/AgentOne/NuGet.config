<?xml version="1.0" encoding="utf-8"?>
<!--
  agent-one pins an Akka.NET 1.6 nightly (the 1.6 line is not on nuget.org yet;
  the nightlies come from Akka.NET's own feedz.io feed). Scoped to this project
  and its tests so the rest of the solution keeps restoring from nuget.org only.
  No source mapping on purpose: Akka.Analyzers, which the nightly pulls in, is
  published on nuget.org.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="akka-nightly" value="https://f.feedz.io/akkadotnet/akka/nuget/index.json" />
  </packageSources>
</configuration>
