    "ai-agent",
    "terminal",
    "local-llm",
    "knowledge-graph",
    "kuzu"
  ],
  "homepage": "https://github.com/psmon/AgentZeroLite/tree/main/Project/AgentOne",
  "bugs": {
    "url": "https://github.com/psmon/AgentZeroLite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psmon/AgentZeroLite.git",
    "directory": "Project/AgentOne/packaging/npm/agent-one"
  },
  "license": "MIT",
  "author": "psmon",
  "bin": {
    "agent-one": "bin/agent-one.js"
  },
  "files": [
    "bin/",
