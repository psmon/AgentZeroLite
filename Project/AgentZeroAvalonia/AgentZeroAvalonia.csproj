<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The cross-platform host (M0034). Plain net10.0 on purpose: no -windows TFM, no
         WPF, no WinRT. Everything Windows-specific it needs (ConPTY, DPAPI, the console
         attach for -cli) is a kernel32/user32/crypt32 P/Invoke fenced by
         OperatingSystem.IsWindows(). ZeroCommon stays the shared brain; this project is
         the shell. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentZeroAvalonia</RootNamespace>
    <!-- Same exe name as the WPF host so the CLI wrappers, the skill guides and the
         `-cli help agentzero` text stay true. The two builds live in different output
         folders and refuse to run side by side (same single-instance name). -->
    <AssemblyName>AgentZeroLite</AssemblyName>
    <Configurations>Debug;Release;AgentCLI</Configurations>
    <Platforms>AnyCPU</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\AgentZeroWpf\agentzero.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Hangul normalisation in SuperTonic and Korean paths need real globalization. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <!-- One version for both hosts: read the WPF project's version.txt. The Release bump
       target stays in the WPF csproj only — one project bumps, both read. -->
  <PropertyGroup>
    <AppVersion>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../AgentZeroWpf/version.txt').Trim())</AppVersion>
    <Version>$(AppVersion)</Version>
    <AssemblyVersion>$(AppVersion).0</AssemblyVersion>
    <FileVersion>$(AppVersion).0</FileVersion>
    <InformationalVersion>$(AppVersion)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- macOS/Linux PTY (forkpty). Windows uses the ConPTY host copied from the WPF
         app and never loads this package's natives. -->
    <PackageReference Include="Porta.Pty" Version="2.2.2" />
    <!-- DPAPI is inbox only on the -windows TFM; on plain net10.0 it is a package. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroCommon\ZeroCommon.csproj" />
  </ItemGroup>

  <!-- The wearable host (Wearable page), the same arrangement as the WPF csproj: a
       build-order-only reference (it targets net10.0-windows10.0.19041.0 for WinRT BLE,
       which a plain net10.0 project cannot reference), its output copied into wearable       next to the exe, and a publish of it alongside ours. Windows only — a macOS build
       must never try to build a WinRT project. IncludeWearableHost=false leaves it out;
       msix/build-msix.ps1 passes that, because a BLE host in the Store package is its own
       certification question (capabilities, size) and must not ride along unnoticed. -->
  <PropertyGroup>
    <IncludeWearableHost Condition="'$(IncludeWearableHost)' == ''">true</IncludeWearableHost>
    <_WearableApplies>false</_WearableApplies>
    <_WearableApplies Condition="'$(IncludeWearableHost)' == 'true' And '$(OS)' == 'Windows_NT' And ('$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win')))">true</_WearableApplies>
  </PropertyGroup>
  <ItemGroup Condition="'$(_WearableApplies)' == 'true'">
    <ProjectReference Include="..\ZeroWearable\ZeroWearable.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false" />
  </ItemGroup>

  <Target Name="CopyWearableHost" AfterTargets="Build" Condition="'$(_WearableApplies)' == 'true'">
    <PropertyGroup>
      <_WearableOut>$(MSBuildProjectDirectory)\..\ZeroWearable\bin\$(Configuration)\net10.0-windows10.0.19041.0\</_WearableOut>
    </PropertyGroup>
    <ItemGroup>
      <_WearableFiles Include="$(_WearableOut)**\*" Exclude="$(_WearableOut)**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_WearableFiles)"
          DestinationFiles="@(_WearableFiles->'$(OutDir)wearable\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_WearableFiles)' != ''" />
    <Message Importance="normal" Text="Wearable host copied: @(_WearableFiles->Count()) file(s) -> $(OutDir)wearable\" />
  </Target>

  <!-- Same RID and self-contained flag as this publish, or a framework-dependent host
       would not start on a machine without the .NET 10 runtime. -->
  <Target Name="PublishWearableHost" AfterTargets="Publish" Condition="'$(_WearableApplies)' == 'true'">
    <PropertyGroup>
      <_WearableRidArg Condition="'$(RuntimeIdentifier)' != ''">-r $(RuntimeIdentifier)</_WearableRidArg>
      <_WearableSelfContainedArg Condition="'$(SelfContained)' == 'true'">--self-contained true</_WearableSelfContainedArg>
      <_WearableSelfContainedArg Condition="'$(SelfContained)' != 'true'">--self-contained false</_WearableSelfContainedArg>
      <_WearablePublishDir>$([System.IO.Path]::GetFullPath('$(PublishDir)'))wearable\</_WearablePublishDir>
    </PropertyGroup>
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\ZeroWearable\ZeroWearable.csproj&quot; -c $(Configuration) $(_WearableRidArg) $(_WearableSelfContainedArg) -p:PublishSingleFile=false -o &quot;$(_WearablePublishDir)&quot;" />
    <Message Importance="high" Text="Wearable host published -> $(_WearablePublishDir)" />
  </Target>

  <ItemGroup>
    <!-- xterm.js and its fonts are one bundle, kept in the WPF folder and linked here:
         the renderer must stay byte-identical between hosts. index.html / term.js are
         this host's own copies (Wasm/xterm/) because the message transport differs. -->
    <Content Include="..\AgentZeroWpf\Wasm\xterm\vendor\**\*"
             Link="Wasm\xterm\vendor\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Wasm\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\AgentZeroWpf\version.txt" Link="version.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The app icon is AgentZero's own, linked rather than copied so the two hosts
         cannot drift: ApplicationIcon stamps the Windows exe (taskbar, desktop shortcut,
         Explorer), the AvaloniaResource is what the windows show in their title bar.
         macOS takes macos/AgentZeroLite.icns, made from the same file. -->
    <AvaloniaResource Include="..\AgentZeroWpf\agentzero.ico" Link="Assets\agentzero.ico" />
    <None Update="AgentZeroLite.sh" CopyToOutputDirectory="PreserveNewest" />
    <None Update="AgentZeroLite.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentZeroAvalonia.Tests" />
  </ItemGroup>

</Project>
