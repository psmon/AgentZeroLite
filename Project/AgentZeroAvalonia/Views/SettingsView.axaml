<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgentZeroAvalonia.ViewModels"
             xmlns:tel="using:Agent.Common.Telemetry"
             x:Class="AgentZeroAvalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        </Style>
        <Style Selector="Button.nav.selected">
            <Setter Property="Background" Value="{DynamicResource CyberBgDeep}" />
            <Setter Property="Foreground" Value="{DynamicResource CyberCyanBrush}" />
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style Selector="TextBlock.lbl">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style Selector="TextBlock.status">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource CyberTealBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Grid.form > TextBox, Grid.form > ComboBox, Grid.form > NumericUpDown, Grid.form > CheckBox, Grid.form > StackPanel">
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="170,*" Background="{DynamicResource CyberBgDeep}">

        <!-- Left navigation -->
        <Border Grid.Column="0" Background="{DynamicResource CyberBgPanel}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,10">
                <TextBlock Text="SETTINGS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextDim}" Margin="12,4,12,8" />
                <Button Classes="nav" Classes.selected="{Binding IsLlm}" Content="LLM" Command="{Binding ShowLlmCommand}" />
                <Button Classes="nav" Classes.selected="{Binding IsMcp}" Content="MCP" Command="{Binding ShowMcpCommand}" />
                <Button Classes="nav" Classes.selected="{Binding IsCli}" Content="CLI definitions" Command="{Binding ShowCliCommand}" />
                <Button Classes="nav" Classes.selected="{Binding IsTerminal}" Content="Terminal" Command="{Binding ShowTerminalCommand}" />
                <Button Classes="nav" Classes.selected="{Binding IsVoice}" Content="Voice" Command="{Binding ShowVoiceCommand}" />
                <Button Classes="nav" Classes.selected="{Binding IsModels}" Content="Models" Command="{Binding ShowModelsCommand}" />
                <Button Classes="nav" Classes.selected="{Binding IsNotifications}" Content="Notifications" Command="{Binding ShowNotificationsCommand}" />
                <Button Classes="nav" Classes.selected="{Binding IsBudget}" Content="Budget" Command="{Binding ShowBudgetCommand}" />
                <Button Classes="nav" Classes.selected="{Binding IsShortcuts}" Content="Shortcuts" Command="{Binding ShowShortcutsCommand}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" Padding="20,16">
            <Panel>

                <!-- ═══ LLM ═══ -->
                <StackPanel IsVisible="{Binding IsLlm}" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Classes="h1" Text="LLM" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton Content="External (OpenAI-compatible)" IsChecked="{Binding UseExternal}" GroupName="backend" />
                        <RadioButton Content="Local (LLamaSharp)" IsChecked="{Binding UseLocal}" GroupName="backend"
                                     IsEnabled="{Binding LocalSupported}" ToolTip.Tip="{Binding LocalTooltip}" />
                    </StackPanel>

                    <TextBlock Classes="h2" Text="EXTERNAL" />
                    <Grid Classes="form" ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Classes="lbl" Grid.Row="0" Text="Provider" />
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" MinWidth="220" HorizontalAlignment="Left" />
                        <TextBlock Classes="lbl" Grid.Row="1" Text="Model" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ExternalModel}" Watermark="google/gemma-4-e4b" />
                        <TextBlock Classes="lbl" Grid.Row="2" Text="Max tokens / turn" />
                        <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ExternalMaxTokens}" Minimum="256" Maximum="32768" Increment="256" HorizontalAlignment="Left" Width="160" />
                        <TextBlock Classes="lbl" Grid.Row="3" Text="Temperature" />
                        <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Temperature}" Minimum="0" Maximum="2" Increment="0.1" FormatString="0.0" HorizontalAlignment="Left" Width="160" />
                        <TextBlock Classes="lbl" Grid.Row="4" Text="OpenAI API key" IsVisible="{Binding ShowOpenAI}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding OpenAIApiKey}" PasswordChar="●" IsVisible="{Binding ShowOpenAI}" Watermark="sk-..." />
                        <TextBlock Classes="lbl" Grid.Row="5" Text="OpenAI base URL" IsVisible="{Binding ShowOpenAI}" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding OpenAIBaseUrl}" IsVisible="{Binding ShowOpenAI}" Watermark="(default)" />
                        <TextBlock Classes="lbl" Grid.Row="6" Text="LM Studio base URL / key" IsVisible="{Binding ShowLMStudio}" />
                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowLMStudio}">
                            <TextBox Text="{Binding LMStudioBaseUrl}" Width="260" Watermark="http://localhost:1234/v1" />
                            <TextBox Text="{Binding LMStudioApiKey}" Width="160" PasswordChar="●" Watermark="key (optional)" />
                        </StackPanel>
                        <TextBlock Classes="lbl" Grid.Row="7" Text="Ollama base URL" IsVisible="{Binding ShowOllama}" />
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding OllamaBaseUrl}" IsVisible="{Binding ShowOllama}" Watermark="(default)" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button Content="Save" Command="{Binding SaveLlmCommand}" />
                        <Button Content="Test connection" Command="{Binding TestExternalCommand}" IsEnabled="{Binding !IsTesting}" />
                    </StackPanel>
                    <TextBlock Classes="status" Text="{Binding LlmStatus}" />

                    <!-- The loop is ours and the model is theirs, so this sits outside both
                         backend groups: it applies whichever one is active. Bounds mirror
                         LlmRuntimeSettings.Min/MaxAgentLoopMaxTurns, which clamp the stored
                         value again for hand-edited files. -->
                    <TextBlock Classes="h2" Text="AGENT LOOP (AI MODE)" />
                    <Grid Classes="form" ColumnDefinitions="130,*" RowDefinitions="Auto,Auto">
                        <TextBlock Classes="lbl" Grid.Row="0" Text="Tool chain turns" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <NumericUpDown Value="{Binding AgentLoopMaxTurns}" Minimum="1" Maximum="200" Increment="1" Width="160" />
                            <Button Content="Save" Command="{Binding SaveLlmCommand}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextDim}"
                                   Text="One turn is one model call plus the tool it asks for, so reading a file, running a command and answering costs three. Raise it for long jobs — when the budget runs out the run ends with 'max iterations reached without done'. Applies to both backends." />
                    </Grid>

                    <StackPanel IsVisible="{Binding LocalSupported}">
                        <TextBlock Classes="h2" Text="LOCAL MODEL (WINDOWS)" />
                        <Grid Classes="form" ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Classes="lbl" Grid.Row="0" Text="Model" />
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" MinWidth="360" HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModelChoice">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Classes="lbl" Grid.Row="1" Text="Backend" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <RadioButton Content="CPU" IsChecked="{Binding !LocalBackendVulkan}" GroupName="lbe" />
                                <RadioButton Content="Vulkan" IsChecked="{Binding LocalBackendVulkan}" GroupName="lbe" />
                                <ComboBox ItemsSource="{Binding VulkanDevices}" SelectedIndex="{Binding VulkanDeviceIndex}" IsVisible="{Binding LocalBackendVulkan}" MinWidth="200" />
                            </StackPanel>
                            <TextBlock Classes="lbl" Grid.Row="2" Text="Context / GPU layers" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <NumericUpDown Value="{Binding ContextSize}" Minimum="1024" Maximum="32768" Increment="1024" Width="150" />
                                <NumericUpDown Value="{Binding GpuLayerCount}" Minimum="0" Maximum="999" Increment="1" Width="120" />
                            </StackPanel>
                            <TextBlock Classes="lbl" Grid.Row="3" Text="File" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ModelStatus}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                            <TextBlock Classes="lbl" Grid.Row="4" Text="Engine" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LocalState}" FontSize="11" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <Button Content="Save options" Command="{Binding SaveLlmCommand}" />
                            <Button Content="Download" Command="{Binding DownloadModelCommand}" IsEnabled="{Binding !IsDownloading}" />
                            <Button Content="Load" Command="{Binding LoadModelCommand}" />
                            <Button Content="Unload" Command="{Binding UnloadModelCommand}" />
                        </StackPanel>
                        <CheckBox Margin="0,8,0,0" IsChecked="{Binding PreloadLocalLlm}"
                                  Content="Load at startup (in the background; otherwise the first AI-mode request loads it)" />
                        <TextBlock Classes="status" Text="{Binding LocalStatus}" />
                    </StackPanel>
                </StackPanel>

                <!-- ═══ CLI DEFINITIONS ═══ -->
                <Grid IsVisible="{Binding IsCli}" ColumnDefinitions="240,*" MaxWidth="900" HorizontalAlignment="Left">
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Classes="h1" Text="CLI definitions" />
                        <ListBox ItemsSource="{Binding CliDefinitions}" SelectedItem="{Binding SelectedCli}" Height="360"
                                 Background="{DynamicResource CyberBgPanel}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CliDefinitionItem">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Name}" FontSize="12" />
                                        <TextBlock Text="built-in" FontSize="9" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" IsVisible="{Binding IsBuiltIn}" />
                                        <TextBlock Text="ssh" FontSize="9" Foreground="{DynamicResource CyberTealBrush}" VerticalAlignment="Center" IsVisible="{Binding IsRemote}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                            <Button Content="New" Command="{Binding NewCliCommand}" />
                            <Button Content="▲" Command="{Binding MoveUpCommand}" />
                            <Button Content="▼" Command="{Binding MoveDownCommand}" />
                            <Button Content="Delete" Command="{Binding DeleteCliCommand}" IsEnabled="{Binding CanDeleteCli}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" DataContext="{Binding SelectedCli}" x:DataType="vm:CliDefinitionItem" IsVisible="{Binding !!.}">
                        <TextBlock Classes="h2" Text="DEFINITION" />
                        <Grid Classes="form" ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Classes="lbl" Grid.Row="0" Text="Name" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" />
                            <TextBlock Classes="lbl" Grid.Row="1" Text="Executable" />
                            <DockPanel Grid.Row="1" Grid.Column="1">
                                <Button DockPanel.Dock="Right" x:Name="PickExeButton" Content="…" Margin="6,0,0,0" />
                                <TextBox Text="{Binding ExePath}" Watermark="cmd.exe / /bin/zsh / claude" />
                            </DockPanel>
                            <TextBlock Classes="lbl" Grid.Row="2" Text="Arguments" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Arguments}" />
                            <TextBlock Classes="lbl" Grid.Row="3" Text="" />
                            <CheckBox Grid.Row="3" Grid.Column="1" Content="Reduced motion (ask the CLI not to animate)" IsChecked="{Binding ReducedMotion}" />
                        </Grid>
                        <!-- Agent CLI: is the tool this definition launches actually on the
                             machine? A valid row for a missing program opens a tab that
                             prints "not recognized", so the check and the fetch live next
                             to the definition that needs them. Hidden for plain shells. -->
                        <StackPanel DataContext="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext)}"
                                    x:DataType="vm:SettingsViewModel" IsVisible="{Binding ShowCliTool}">
                            <TextBlock Classes="h2" Text="{Binding CliToolName, StringFormat='AGENT CLI · {0}'}" />
                            <TextBlock Classes="status" Margin="0,0,0,8" Text="{Binding CliToolStatus}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Check again" Command="{Binding CheckCliToolCommand}" />
                                <Button Content="{Binding CliToolName, StringFormat='Install {0}'}"
                                        Command="{Binding InstallCliToolCommand}"
                                        IsEnabled="{Binding CanInstallCliTool}" />
                                <TextBlock Classes="lbl" Text="working…" IsVisible="{Binding IsInstallingTool}" />
                            </StackPanel>
                            <TextBox Text="{Binding InstallLog}" IsVisible="{Binding HasInstallLog}"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                     FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="11"
                                     Height="120" Margin="0,8,0,0" />
                        </StackPanel>

                        <TextBlock Classes="h2" Text="REMOTE SHELL (SSH)" />
                        <Grid Classes="form" ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                              IsEnabled="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SshEditable}">
                            <TextBlock Classes="lbl" Grid.Row="0" Text="" />
                            <CheckBox Grid.Row="0" Grid.Column="1" Content="Connect over SSH after the shell starts" IsChecked="{Binding IsRemote}" />
                            <TextBlock Classes="lbl" Grid.Row="1" Text="Host / user" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <TextBox Text="{Binding SshHost}" Width="220" Watermark="host" />
                                <TextBox Text="{Binding SshUser}" Width="140" Watermark="user" />
                            </StackPanel>
                            <TextBlock Classes="lbl" Grid.Row="2" Text="Auth" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <RadioButton Content="Public key" IsChecked="{Binding UsePublicKey}" GroupName="ssh" />
                                <RadioButton Content="Password" IsChecked="{Binding !UsePublicKey}" GroupName="ssh" />
                            </StackPanel>
                            <TextBlock Classes="lbl" Grid.Row="3" Text="Key file" />
                            <DockPanel Grid.Row="3" Grid.Column="1">
                                <Button DockPanel.Dock="Right" x:Name="PickKeyButton" Content="…" Margin="6,0,0,0" />
                                <TextBox Text="{Binding SshKeyPath}" Watermark=".pem" />
                            </DockPanel>
                            <TextBlock Classes="lbl" Grid.Row="4" Text="Password" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding NewPassword}" PasswordChar="●" Watermark="{Binding PasswordHint}" />
                        </Grid>
                    </StackPanel>
                </Grid>
                <StackPanel IsVisible="{Binding IsCli}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="256,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button Content="Save definition" Command="{Binding SaveCliCommand}" />
                    </StackPanel>
                    <TextBlock Classes="status" Text="{Binding CliStatus}" />
                </StackPanel>

                <!-- ═══ TERMINAL ═══ -->
                <StackPanel IsVisible="{Binding IsTerminal}" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Classes="h1" Text="Terminal appearance" />
                    <Grid Classes="form" ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Classes="lbl" Grid.Row="0" Text="Font family" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FontFamily}" Watermark="JetBrains Mono, Cascadia Mono, Consolas, monospace" />
                        <TextBlock Classes="lbl" Grid.Row="1" Text="Font size" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding FontSize}" Minimum="8" Maximum="32" Increment="1" Width="140" HorizontalAlignment="Left" />
                        <TextBlock Classes="lbl" Grid.Row="2" Text="Line height" />
                        <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding LineHeight}" Minimum="0.8" Maximum="2" Increment="0.05" FormatString="0.00" Width="140" HorizontalAlignment="Left" />
                        <TextBlock Classes="lbl" Grid.Row="3" Text="Theme" />
                        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding ThemeName}" MinWidth="200" HorizontalAlignment="Left" />
                        <TextBlock Classes="lbl" Grid.Row="4" Text="" />
                        <CheckBox Grid.Row="4" Grid.Column="1" Content="Blink the cursor" IsChecked="{Binding CursorBlink}" />
                        <TextBlock Classes="lbl" Grid.Row="5" Text="" />
                        <CheckBox Grid.Row="5" Grid.Column="1" Content="WebGL renderer (applies to terminals opened afterwards)" IsChecked="{Binding UseWebGl}" />
                    </Grid>
                    <TextBlock Classes="h1" Text="Session resume" Margin="0,16,0,0" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}"
                               Text="When a Claude or Codex terminal starts, list the sessions that agent already recorded for the workspace folder (newest first) and offer to reopen one. Turned off by the dialog's &quot;Don't ask again&quot;; tick here to ask again." />
                    <StackPanel Spacing="4" Margin="0,8,0,0">
                        <CheckBox Content="Ask to resume a Claude session (claude --resume)" IsChecked="{Binding AskResumeClaude}" />
                        <CheckBox Content="Ask to resume a Codex session (codex resume)" IsChecked="{Binding AskResumeCodex}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button Content="Apply and save" Command="{Binding SaveTerminalCommand}" />
                    </StackPanel>
                    <TextBlock Classes="status" Text="{Binding TerminalStatus}" />
                </StackPanel>

                <!-- ═══ Notifications ═══ -->
                <StackPanel IsVisible="{Binding IsNotifications}" MaxWidth="640" HorizontalAlignment="Left">
                  <StackPanel DataContext="{Binding Notifications}" x:DataType="vm:NotificationSettingsViewModel">
                    <TextBlock Classes="h1" Text="Notifications" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}"
                               Text="When an agent in any terminal starts needing you — blocked on input or an approval, or finished a turn you have not looked at — say so outside the sidebar: a small popup in the screen corner (click it to go to that terminal) and the taskbar / Dock. Each terminal alerts once per change, not again while it stays that way." />
                    <StackPanel Spacing="4" Margin="0,10,0,0">
                        <CheckBox Content="Notify me" IsChecked="{Binding Enabled}" />
                        <StackPanel Spacing="4" Margin="22,0,0,0" IsEnabled="{Binding Enabled}">
                            <CheckBox Content="when an agent is blocked (input or approval)" IsChecked="{Binding OnBlocked}" />
                            <CheckBox Content="when an agent finished and I have not looked" IsChecked="{Binding OnDone}" />
                            <CheckBox Content="only while AgentZero is not the active window" IsChecked="{Binding OnlyWhenInactive}" />
                            <TextBlock Classes="h2" Text="HOW" />
                            <CheckBox Content="{Binding FlashLabel}" IsChecked="{Binding FlashWindow}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox Content="Corner popup for" IsChecked="{Binding Popup}" VerticalAlignment="Center" />
                                <NumericUpDown Value="{Binding PopupSeconds}" Minimum="3" Maximum="60" Increment="1" Width="120" IsEnabled="{Binding Popup}" />
                                <TextBlock Classes="lbl" Text="seconds" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                        <Button Content="Save" Command="{Binding SaveCommand}" />
                        <Button Content="Test" Command="{Binding TestCommand}" />
                    </StackPanel>
                    <TextBlock Classes="status" Text="{Binding Status}" />
                  </StackPanel>
                </StackPanel>

                <!-- ═══ Shortcuts ═══ -->
                <StackPanel IsVisible="{Binding IsShortcuts}" MaxWidth="820" HorizontalAlignment="Left">
                  <StackPanel DataContext="{Binding Shortcuts}" x:DataType="vm:ShortcutsViewModel">
                    <TextBlock Classes="h1" Text="Shortcuts" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}"
                               Text="The keys for the window's commands. Type a binding (Ctrl+Alt+K), leave it blank for the default, or type none to give the keys back to the programs in your terminals. They work inside a focused terminal too, and a save applies at once. The file (shortcut-settings.json) is shared with the WPF host." />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}" Text="{Binding ModifierNote}" Margin="0,4,0,0" />
                    <Grid ColumnDefinitions="300,140,180,Auto" Margin="0,12,0,4">
                        <TextBlock Classes="lbl" Text="command" />
                        <TextBlock Classes="lbl" Grid.Column="1" Text="default" />
                        <TextBlock Classes="lbl" Grid.Column="2" Text="your keys" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShortcutRowViewModel">
                                <StackPanel Margin="0,2">
                                    <Grid ColumnDefinitions="300,140,180,Auto">
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" ToolTip.Tip="{Binding Id}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DefaultText}" FontSize="11" Foreground="{DynamicResource TextDim}"
                                                   FontFamily="Cascadia Mono, Consolas, Menlo, monospace" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="2" Text="{Binding Text}" Watermark="(default)" Margin="0,0,6,0"
                                                 FontFamily="Cascadia Mono, Consolas, Menlo, monospace" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                            <Button Content="↺" ToolTip.Tip="Back to the default" Command="{Binding ResetCommand}" />
                                            <Button Content="none" ToolTip.Tip="No keys — free them for the terminal" Command="{Binding RemoveCommand}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding Problem}" IsVisible="{Binding HasProblem}" FontSize="11"
                                               Foreground="{DynamicResource CyberYellowBrush}" Margin="300,1,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button Content="Save" Command="{Binding SaveCommand}" />
                        <Button Content="All to defaults" Command="{Binding ResetAllCommand}" />
                    </StackPanel>
                    <TextBlock Classes="status" Text="{Binding Status}" />
                  </StackPanel>
                </StackPanel>

                <!-- ═══ Budget ═══ -->
                <StackPanel IsVisible="{Binding IsBudget}" MaxWidth="780" HorizontalAlignment="Left">
                  <StackPanel DataContext="{Binding Budget}" x:DataType="vm:BudgetViewModel">
                    <TextBlock Classes="h1" Text="Budget" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}"
                               Text="What the agents in your terminals (Claude Code, Codex) have cost, estimated from the token usage they record — read from their own logs, nothing is sent anywhere. Prices are editable per model; the shared file is budget-settings.json." />

                    <TextBlock Text="{Binding SpendText}" Foreground="{Binding SpendBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,2" />
                    <TextBlock Text="{Binding AllTimeText}" FontSize="11" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" />

                    <Grid Classes="form" ColumnDefinitions="130,*" Margin="0,10,0,0">
                        <TextBlock Classes="lbl" Text="Monthly cap (USD)" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding CapText}" Width="120" Watermark="0 = no cap" />
                            <Button Content="Save" Command="{Binding SaveCommand}" />
                            <Button Content="Refresh" Command="{Binding RefreshNowCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Classes="status" Text="{Binding Status}" />

                    <Grid ColumnDefinitions="*,16,*" Margin="0,8,0,0">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="h2" Text="THIS MONTH BY MODEL" />
                            <ItemsControl ItemsSource="{Binding ByModel}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="tel:CostLine">
                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,1">
                                            <TextBlock Text="{Binding Key}" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Turns, StringFormat='{}{0:N0} turns'}" FontSize="11" Foreground="{DynamicResource TextDim}" Margin="8,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Usd, StringFormat='${0:F2}'}" FontSize="12" Foreground="{DynamicResource CyberTealBrush}" MinWidth="70" TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Classes="h2" Text="THIS MONTH BY PROJECT FOLDER" />
                            <ItemsControl ItemsSource="{Binding ByProject}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="tel:CostLine">
                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,1">
                                            <TextBlock Text="{Binding Key}" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Turns, StringFormat='{}{0:N0} turns'}" FontSize="11" Foreground="{DynamicResource TextDim}" Margin="8,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Usd, StringFormat='${0:F2}'}" FontSize="12" Foreground="{DynamicResource CyberTealBrush}" MinWidth="70" TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>

                    <TextBlock Classes="h2" Text="PRICE OVERRIDES (USD PER MILLION TOKENS)" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}"
                               Text="A row matches any model whose name contains its key (lower case) and is tried before the built-in table (Claude Fable / Opus / Sonnet / Haiku by generation, then gpt-4o, o3, gpt). First match wins." />
                    <Border Background="#33FFC24D" CornerRadius="4" Padding="8,6" Margin="0,6,0,0" IsVisible="{Binding HasUnpriced}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Add rows for these" Command="{Binding AddUnpricedCommand}" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding UnpricedText}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Grid ColumnDefinitions="200,90,90,90,90,Auto" Margin="0,8,0,2">
                        <TextBlock Classes="lbl" Text="model key" />
                        <TextBlock Classes="lbl" Grid.Column="1" Text="input" />
                        <TextBlock Classes="lbl" Grid.Column="2" Text="output" />
                        <TextBlock Classes="lbl" Grid.Column="3" Text="cache write" />
                        <TextBlock Classes="lbl" Grid.Column="4" Text="cache read" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Prices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PriceRowViewModel">
                                <Grid ColumnDefinitions="200,90,90,90,90,Auto" Margin="0,2">
                                    <TextBox Text="{Binding Key}" Margin="0,0,6,0" Watermark="e.g. fable" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding Input}" Minimum="0" Increment="0.1" FormatString="0.##" ShowButtonSpinner="False" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="2" Value="{Binding Output}" Minimum="0" Increment="0.1" FormatString="0.##" ShowButtonSpinner="False" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="3" Value="{Binding CacheWrite}" Minimum="0" Increment="0.1" FormatString="0.##" ShowButtonSpinner="False" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="4" Value="{Binding CacheRead}" Minimum="0" Increment="0.01" FormatString="0.###" ShowButtonSpinner="False" Margin="0,0,6,0" />
                                    <Button Grid.Column="5" Content="✕" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this row" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="+ Add price" Command="{Binding AddPriceCommand}" />
                        <Button Content="Save" Command="{Binding SaveCommand}" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>

                <!-- ═══ MCP ═══ -->
                <StackPanel IsVisible="{Binding IsMcp}" MaxWidth="780" HorizontalAlignment="Left">
                  <StackPanel DataContext="{Binding Mcp}" x:DataType="vm:McpSettingsViewModel">
                    <TextBlock Classes="h1" Text="MCP servers" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}"
                               Text="Model Context Protocol servers the bot's AI mode may call. Load a server's tools to teach them to the agent; untick a tool to keep the agent from calling it. The agent names them server.tool (memorizer.search). Header and env values are stored encrypted (mcp-settings.json)." />

                    <Grid ColumnDefinitions="190,*" Margin="0,12,0,0">
                        <!-- server list -->
                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                <Button Content="+ Add" Command="{Binding AddServerCommand}" />
                                <Button Content="Remove" Command="{Binding RemoveServerCommand}" IsEnabled="{Binding HasSelection}" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" MinHeight="160"
                                     Background="{DynamicResource CyberBgPanel}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:McpServerItem">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ListLabel}" FontSize="12" />
                                            <TextBlock Text="{Binding AllowedSummary}" FontSize="10" Foreground="{DynamicResource TextDim}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- server editor -->
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" IsVisible="{Binding HasSelection}">
                          <StackPanel DataContext="{Binding SelectedServer}" x:DataType="vm:McpServerItem">
                            <Grid Classes="form" ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                <TextBlock Classes="lbl" Grid.Row="0" Text="Name" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                    <TextBox Text="{Binding Name}" Width="200" Watermark="memorizer" />
                                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" />
                                </StackPanel>
                                <TextBlock Classes="lbl" Grid.Row="1" Text="Transport" />
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Transports}" SelectedItem="{Binding Transport}" Width="140" HorizontalAlignment="Left"
                                          ToolTip.Tip="stdio = a local process; http = Streamable HTTP (current spec); sse = the older HTTP+SSE transport" />
                                <TextBlock Classes="lbl" Grid.Row="2" Text="URL" IsVisible="{Binding IsHttp}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Url}" IsVisible="{Binding IsHttp}" Watermark="https://example.com/mcp" />
                                <TextBlock Classes="lbl" Grid.Row="3" Text="Command" IsVisible="{Binding IsStdio}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Command}" IsVisible="{Binding IsStdio}" Watermark="npx  (or uvx, node, a full path)" />
                                <TextBlock Classes="lbl" Grid.Row="4" Text="Arguments" IsVisible="{Binding IsStdio}" VerticalAlignment="Top" Margin="0,6,10,0" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ArgsText}" IsVisible="{Binding IsStdio}" AcceptsReturn="True" MinHeight="54"
                                         Watermark="one argument per line, e.g.&#10;-y&#10;@modelcontextprotocol/server-filesystem" />
                            </Grid>

                            <TextBlock Classes="h2" Text="HEADERS" IsVisible="{Binding IsHttp}" />
                            <StackPanel IsVisible="{Binding IsHttp}">
                                <ItemsControl ItemsSource="{Binding Headers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:McpKeyValueRow">
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                                <TextBox Text="{Binding Key}" Width="160" Watermark="X-API-Key" />
                                                <TextBox Text="{Binding Value}" Width="280" PasswordChar="●" Watermark="value" />
                                                <Button Content="✕" Command="{Binding $parent[ItemsControl].((vm:McpServerItem)DataContext).RemoveHeaderCommand}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="+ Header" Command="{Binding AddHeaderCommand}" Margin="0,4,0,0" />
                            </StackPanel>

                            <TextBlock Classes="h2" Text="ENVIRONMENT" IsVisible="{Binding IsStdio}" />
                            <StackPanel IsVisible="{Binding IsStdio}">
                                <ItemsControl ItemsSource="{Binding Env}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:McpKeyValueRow">
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                                <TextBox Text="{Binding Key}" Width="160" Watermark="GITHUB_TOKEN" />
                                                <TextBox Text="{Binding Value}" Width="280" PasswordChar="●" Watermark="value" />
                                                <Button Content="✕" Command="{Binding $parent[ItemsControl].((vm:McpServerItem)DataContext).RemoveEnvCommand}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="+ Variable" Command="{Binding AddEnvCommand}" Margin="0,4,0,0" />
                            </StackPanel>

                            <TextBlock Classes="h2" Text="TOOLS — ALLOW THE AGENT TO CALL" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="⟳ Load tools" Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).Mcp.LoadToolsCommand}"
                                        ToolTip.Tip="Connect with the settings above (saved or not) and list the server's tools" />
                                <Button Content="Allow all" Command="{Binding AllowAllToolsCommand}" />
                                <Button Content="Deny all" Command="{Binding DenyAllToolsCommand}" />
                                <TextBlock Text="{Binding AllowedSummary}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource CyberTealBrush}" />
                            </StackPanel>
                            <TextBlock Classes="status" Text="{Binding ToolsState}" />
                            <ItemsControl ItemsSource="{Binding Tools}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:McpToolItem">
                                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,5">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Allowed}" VerticalAlignment="Top" Margin="0,0,8,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" />
                                                    <TextBlock Text="{Binding ArgsSummary}" FontSize="10" FontFamily="JetBrains Mono, Cascadia Mono, Consolas, monospace"
                                                               Foreground="{DynamicResource CyberTealBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextDim}"
                                                               TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                        <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding IsIdle}" />
                    </StackPanel>
                    <ProgressBar Margin="0,8,0,0" Height="4" IsVisible="{Binding IsBusy}" IsIndeterminate="True" />
                    <TextBlock Classes="status" Text="{Binding Status}" />

                    <TextBlock Classes="h2" Text="TEST A TOOL" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox ItemsSource="{Binding SelectedServer.Tools}" SelectedItem="{Binding TestTool}" MinWidth="220">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:McpToolItem">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="▶ Call" Command="{Binding TestCallCommand}" IsEnabled="{Binding IsIdle}"
                                ToolTip.Tip="Run the tool once with these arguments, as the agent would (works before saving)" />
                    </StackPanel>
                    <TextBox Text="{Binding TestArgs}" Margin="0,6,0,0" FontFamily="JetBrains Mono, Cascadia Mono, Consolas, monospace"
                             Watermark="{}{&quot;query&quot;: &quot;actor model&quot;}" />
                    <TextBox Text="{Binding TestResult}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,6,0,0" MinHeight="60" MaxHeight="320" />

                    <TextBlock Classes="h2" Text="IMPORT (mcpServers JSON)" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}"
                               Text="Paste an mcpServers block from Claude Code (.mcp.json, ~/.claude.json), Claude Desktop or Cursor. Imported servers load their tools right away; a server with the same name is replaced." />
                    <TextBox Text="{Binding ImportText}" AcceptsReturn="True" MinHeight="80" Margin="0,6,0,0" FontFamily="JetBrains Mono, Cascadia Mono, Consolas, monospace"
                             Watermark="{}{ &quot;mcpServers&quot;: { &quot;memorizer&quot;: { &quot;type&quot;: &quot;sse&quot;, &quot;url&quot;: &quot;https://…/sse&quot;, &quot;headers&quot;: { &quot;X-API-Key&quot;: &quot;…&quot; } } } }" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <Button Content="Import" Command="{Binding ImportCommand}" IsEnabled="{Binding IsIdle}" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>

                <!-- ═══ MODELS ═══ -->
                <StackPanel IsVisible="{Binding IsModels}" MaxWidth="720" HorizontalAlignment="Left">
                  <StackPanel DataContext="{Binding OnDeviceModels}" x:DataType="vm:OnDeviceModelsViewModel" Spacing="6">
                    <TextBlock Classes="h1" Text="On-device models" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}"
                               Text="What the Plugins page's voice note, live music and vision run on. Shared with the Windows host (%LOCALAPPDATA%\AgentZeroLite\models): a model either host downloaded is found by both. Whisper and Supertonic are on the Voice page." />
                    <ItemsControl ItemsSource="{Binding Models}" Margin="0,8,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OnDeviceModelRow">
                          <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock>
                                  <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
                                  <Run Text="{Binding Size, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextDim}" />
                                </TextBlock>
                                <TextBlock Text="{Binding UsedBy}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}" />
                                <TextBlock Text="{Binding Location}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}" />
                                <TextBlock Text="{Binding State}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource CyberCyanBrush}" />
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding !PercentKnown}"
                                             Height="4" IsVisible="{Binding IsDownloading}" />
                              </StackPanel>
                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="12,0,0,0">
                                <Button Content="Download" Command="{Binding DownloadCommand}" IsEnabled="{Binding CanDownload}" />
                                <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsDownloading}" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox Content="Speaker labels in voice notes (Sherpa diarization)" IsChecked="{Binding SpeakerLabels}" />
                    <Button Content="Re-check" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
                  </StackPanel>
                </StackPanel>

                <!-- ═══ VOICE ═══ -->
                <StackPanel IsVisible="{Binding IsVoice}" MaxWidth="640" HorizontalAlignment="Left">
                  <StackPanel DataContext="{Binding Voice}" x:DataType="vm:VoiceSettingsViewModel">
                    <TextBlock Classes="h1" Text="Voice" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}"
                               Text="Shared with the Windows host and the wearable host (voice-settings.json). The watch speaks with Supertonic or KittenTTS 2 (multilingual, Windows), and listens with Whisper (local)." />

                    <TextBlock Classes="h2" Text="SPEECH TO TEXT (EAR)" />
                    <Grid Classes="form" ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Classes="lbl" Grid.Row="0" Text="Provider" />
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding SttProviders}" SelectedItem="{Binding SttProvider}" MinWidth="220" HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextDim}" IsVisible="{Binding !SttRunsHere}" TextWrapping="Wrap"
                                   Text="This provider runs in the Windows host only. It stays selected so saving here does not change it." />
                        <TextBlock Classes="lbl" Grid.Row="2" Text="Whisper model" IsVisible="{Binding ShowWhisper}" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowWhisper}">
                            <ComboBox ItemsSource="{Binding WhisperModels}" SelectedItem="{Binding SttWhisperModel}" Width="120" />
                            <Button Content="Download" Command="{Binding DownloadWhisperCommand}" IsEnabled="{Binding IsIdle}" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextDim}" Text="{Binding WhisperState}" IsVisible="{Binding ShowWhisper}" TextWrapping="Wrap" />
                        <!-- SherpaStreaming: text while the person speaks (Nemotron 3.5 ASR is the official model) -->
                        <TextBlock Classes="lbl" Grid.Row="2" Text="Streaming model" IsVisible="{Binding ShowStreaming}" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowStreaming}">
                            <ComboBox ItemsSource="{Binding StreamingModels}" SelectedItem="{Binding StreamingModel}" MinWidth="320" />
                            <Button Content="Download" Command="{Binding DownloadStreamingCommand}" IsEnabled="{Binding IsIdle}" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextDim}" Text="{Binding StreamingState}" IsVisible="{Binding ShowStreaming}" TextWrapping="Wrap" />
                        <TextBlock Classes="lbl" Grid.Row="7" Text="Endpoint (ms)" IsVisible="{Binding ShowStreaming}" />
                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowStreaming}">
                            <NumericUpDown Value="{Binding StreamingEndpointMs}" Minimum="300" Maximum="3000" Increment="100" FormatString="0" Width="130" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="silence that ends an utterance and sends it — lower answers sooner" />
                        </StackPanel>
                        <TextBlock Classes="lbl" Grid.Row="4" Text="GPU (Vulkan)" IsVisible="{Binding GpuSupported}" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding GpuSupported}">
                            <CheckBox Content="Use GPU" IsChecked="{Binding SttUseGpu}" IsEnabled="{Binding ShowWhisper}" />
                            <ComboBox ItemsSource="{Binding GpuChoices}" SelectedItem="{Binding SttGpu}" MinWidth="240" IsEnabled="{Binding SttUseGpu}" />
                        </StackPanel>
                        <TextBlock Classes="lbl" Grid.Row="5" Text="OpenAI API key" IsVisible="{Binding ShowSttKey}" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SttOpenAIApiKey}" PasswordChar="●" Watermark="sk-..." IsVisible="{Binding ShowSttKey}" />
                        <TextBlock Classes="lbl" Grid.Row="6" Text="Language" />
                        <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding SttLanguages}" SelectedItem="{Binding SttLanguage}" Width="120" HorizontalAlignment="Left" />
                    </Grid>

                    <TextBlock Classes="h2" Text="TEXT TO SPEECH (VOICE)" />
                    <Grid Classes="form" ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Classes="lbl" Grid.Row="0" Text="Provider" />
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding TtsProviders}" SelectedItem="{Binding TtsProvider}" MinWidth="220" HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextDim}" IsVisible="{Binding !TtsRunsHere}" TextWrapping="Wrap"
                                   Text="This provider runs in the Windows host only. It stays selected so saving here does not change it." />
                        <TextBlock Classes="lbl" Grid.Row="2" Text="Supertonic model" IsVisible="{Binding ShowSupertonic}" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowSupertonic}">
                            <Button Content="Download model" Command="{Binding DownloadSupertonicCommand}" IsEnabled="{Binding IsIdle}" />
                            <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}" Text="{Binding SupertonicState}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Classes="lbl" Grid.Row="3" Text="Voice / language" IsVisible="{Binding ShowSupertonic}" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowSupertonic}">
                            <ComboBox ItemsSource="{Binding SupertonicVoices}" SelectedItem="{Binding SupertonicVoice}" Width="90" />
                            <ComboBox ItemsSource="{Binding SupertonicLanguages}" SelectedItem="{Binding SupertonicLanguage}" Width="90" />
                        </StackPanel>
                        <TextBlock Classes="lbl" Grid.Row="4" Text="Steps / speed" IsVisible="{Binding ShowSupertonic}" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowSupertonic}">
                            <NumericUpDown Value="{Binding SupertonicSteps}" Minimum="5" Maximum="12" Increment="1" Width="120" />
                            <NumericUpDown Value="{Binding SupertonicSpeed}" Minimum="0.7" Maximum="2.0" Increment="0.05" FormatString="0.00" Width="120" />
                        </StackPanel>
                        <TextBlock Classes="lbl" Grid.Row="5" Text="Voice" IsVisible="{Binding ShowOpenAiTts}" />
                        <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding OpenAiVoices}" SelectedItem="{Binding OpenAiVoice}" Width="140" HorizontalAlignment="Left" IsVisible="{Binding ShowOpenAiTts}" />
                        <TextBlock Classes="lbl" Grid.Row="6" Text="OpenAI API key" IsVisible="{Binding ShowOpenAiTts}" />
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding TtsOpenAIApiKey}" PasswordChar="●" Watermark="sk-..." IsVisible="{Binding ShowOpenAiTts}" />
                        <TextBlock Classes="lbl" Grid.Row="7" Text="KittenTTS 2" IsVisible="{Binding ShowKitten2}" />
                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowKitten2}">
                            <Button Content="Download (~3.3 GB)" Command="{Binding DownloadKitten2Command}" IsEnabled="{Binding IsIdle}"
                                    ToolTip.Tip="From AgentZero's GitHub Release; an interrupted download resumes; every file's SHA-256 is checked" />
                            <TextBox Text="{Binding Kitten2Source}" Watermark="…or a folder holding the bundle" Width="220" />
                            <Button Content="Install" Command="{Binding InstallKitten2Command}" IsEnabled="{Binding IsIdle}"
                                    ToolTip.Tip="Copy the bundle into the models folder, checking every file's SHA-256" />
                        </StackPanel>
                        <TextBlock Grid.Row="8" Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextDim}" Text="{Binding Kitten2State}" IsVisible="{Binding ShowKitten2}" TextWrapping="Wrap" />
                        <TextBlock Classes="lbl" Grid.Row="9" Text="Voice / language" IsVisible="{Binding ShowKitten2}" />
                        <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowKitten2}">
                            <ComboBox ItemsSource="{Binding Kitten2Voices}" SelectedItem="{Binding Kitten2Voice}" MinWidth="170" />
                            <ComboBox ItemsSource="{Binding Kitten2Languages}" SelectedItem="{Binding Kitten2Language}" Width="80"
                                      ToolTip.Tip="The language answers are written in (the watch's brain answers in it)" />
                        </StackPanel>
                        <TextBlock Classes="lbl" Grid.Row="10" Text="Device" IsVisible="{Binding ShowKitten2}" />
                        <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowKitten2}">
                            <ComboBox ItemsSource="{Binding Kitten2DeviceChoices}" SelectedItem="{Binding Kitten2Device}" Width="100"
                                      ToolTip.Tip="Where the speech LM runs. Auto = GPU (Vulkan) when there is one, else CPU. The decoder always runs on the CPU." />
                            <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"
                                       Text="GPU ≈ real time · CPU is several times slower · applies on the next load (restart the wearable host)" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding IsIdle}"
                                ToolTip.Tip="Saves, then loads the chosen voice in the background and keeps it in memory" />
                        <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}" Text="{Binding VoiceMemoryState}" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Classes="h2" Text="LOAD AT STARTUP" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}"
                               Text="Off: a model loads the first time something uses it (or when you Save here) and then stays loaded. On: it loads in the background right after AgentZero starts — ready for the first request, at the cost of memory from the start." />
                    <CheckBox IsChecked="{Binding PreloadVoiceOut}" Content="Voice output (the TTS chosen above)" />
                    <CheckBox IsChecked="{Binding PreloadVoiceIn}" Content="Voice input (local Whisper or the streaming model)" />

                    <TextBlock Classes="h2" Text="TEST" />
                    <TextBox Text="{Binding TestText}" Watermark="A line to speak" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="▶ Speak" Command="{Binding SpeakCommand}" IsEnabled="{Binding IsIdle}"
                                ToolTip.Tip="Synthesise the line with the TTS above and play it" />
                        <Button Content="⟲ Round trip" Command="{Binding RoundTripCommand}" IsEnabled="{Binding IsIdle}"
                                ToolTip.Tip="Synthesise, play, and feed the same audio through the STT above" />
                        <Button Content="■ Stop" Command="{Binding StopCommand}" IsEnabled="{Binding IsBusy}" />
                        <ToggleButton Content="🎙 Listen live" IsChecked="{Binding IsListening, Mode=OneWay}"
                                      Command="{Binding ListenLiveCommand}" IsVisible="{Binding ShowStreaming}" IsEnabled="{Binding MicSupported}"
                                      ToolTip.Tip="Microphone → the streaming model above; the words appear in Heard while you speak. Press again to stop." />
                    </StackPanel>
                    <ProgressBar Margin="0,8,0,0" Height="4" IsVisible="{Binding IsBusy}"
                                 IsIndeterminate="{Binding !ProgressKnown}" Value="{Binding Progress}" Maximum="100" />
                    <TextBlock Classes="status" Text="{Binding Status}" />
                    <TextBlock Classes="lbl" Margin="0,8,0,2" Text="Heard" />
                    <TextBox Text="{Binding Heard}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="48" />
                  </StackPanel>
                </StackPanel>

            </Panel>
        </ScrollViewer>
    </Grid>
</UserControl>
