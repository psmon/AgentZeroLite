<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgentZeroAvalonia.ViewModels"
        xmlns:views="using:AgentZeroAvalonia.Views"
        x:Class="AgentZeroAvalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1180" Height="760" MinWidth="820" MinHeight="520"
        Background="{DynamicResource CyberBgDeep}"
        Icon="avares://AgentZeroLite/Assets/agentzero.ico"
        Title="{Binding WindowTitle}">

    <Window.Styles>
        <Style Selector="Border.ws">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Border.ws.selected">
            <Setter Property="Background" Value="{DynamicResource CyberBgDeep}" />
        </Style>
        <!-- The workspace the focused terminal is in: an accent bar, a tint and the name in teal —
             the same shape as the focused session below, in its own colour so "which workspace"
             and "which terminal" read apart. A row whose nested worktree is the active workspace
             gets the bar only, dimmed. -->
        <Style Selector="Border.ws.wsrow">
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.ws.wsrow.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource CyberTealBrush}" />
            <Setter Property="Background" Value="#224EC9B0" />
        </Style>
        <Style Selector="Border.ws.wsrow.selected TextBlock.wsname">
            <Setter Property="Foreground" Value="{DynamicResource CyberTealBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.ws.wsrow.holds">
            <Setter Property="BorderBrush" Value="#804EC9B0" />
        </Style>
        <Style Selector="Border.ws.wsrow.holds TextBlock.wsname">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.side">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        </Style>
        <Style Selector="Border.ws.selected Button.side">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <!-- The focused terminal: an accent bar, a tint and the name in the accent colour, so a
             workspace switch or a jump from ACTIVE SESSIONS shows at a glance where you landed. -->
        <Style Selector="Border.ws.session">
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.ws.session.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource CyberCyanBrush}" />
            <Setter Property="Background" Value="#263794FF" />
        </Style>
        <Style Selector="Border.ws.session.selected Button.side">
            <Setter Property="Foreground" Value="{DynamicResource CyberCyanBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.ws.session.selected TextBlock.title">
            <Setter Property="Foreground" Value="{DynamicResource CyberCyanBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.sidex">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.sidex:pointerover">
            <Setter Property="Foreground" Value="#f14c4c" />
        </Style>
        <!-- The sidebar's own hide / show chevron: small and quiet, part of the panel. -->
        <Style Selector="Button.fold">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.fold:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- M0041: bot pane chrome -->
        <Style Selector="Button.chrome">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        </Style>
        <Style Selector="Button.chrome:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource BorderColor}" />
        </Style>
        <!-- Bottom panel tabs (VS Code's panel; the WPF host's BOT / NOTE tabs) -->
        <Style Selector="Button.ptab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        </Style>
        <Style Selector="Button.ptab.selected">
            <Setter Property="Foreground" Value="{DynamicResource CyberCyanBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CyberCyanBrush}" />
        </Style>
        <!-- GIT LOG with no readable history: dimmed, not Fluent's grey slab. -->
        <Style Selector="Button.ptab:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Button.ptab:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <!-- The WPF MainWindow's frame: activity bar (48) · sidebar · content · status bar. -->
    <Grid RowDefinitions="*,24">

        <Grid Grid.Row="0" x:Name="ShellGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <!-- Rows, as in the WPF host: content · bot splitter · bot dock. Heights are
                 driven from code-behind so a hidden dock takes no space. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="90" />
                <RowDefinition Height="0" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>

            <!-- Activity bar -->
            <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource CyberBgPanel}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Button Classes="activity" Classes.selected="{Binding IsTerminalsPage}"
                                Content="▣" ToolTip.Tip="Terminals" Command="{Binding ShowTerminalsCommand}" />
                        <Button Classes="activity" Classes.selected="{Binding BotVisible}"
                                Content="🤖" ToolTip.Tip="AgentBot" Command="{Binding ToggleBotCommand}" />
                        <Button Classes="activity" Classes.selected="{Binding CodeVisible}"
                                Content="📄" ToolTip.Tip="Code — the workspace's files (Ctrl+Alt+E)"
                                Command="{Binding ToggleCodeCommand}" />
                        <Button Classes="activity" Classes.selected="{Binding IsWearablePage}"
                                Content="⌚" ToolTip.Tip="Wearable" Command="{Binding ShowWearableCommand}"
                                IsVisible="{Binding WearableSupported}" />
                        <Button Classes="activity" Classes.selected="{Binding IsPluginsPage}"
                                Content="🧩" ToolTip.Tip="Plugins" Command="{Binding ShowPluginsCommand}" />
                        <Button Classes="activity" Classes.selected="{Binding IsRemotePage}"
                                Content="📡" ToolTip.Tip="Remote — use the terminals from a browser" Command="{Binding ShowRemoteCommand}"
                                IsVisible="{Binding RemoteSupported}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Classes="activity" Classes.selected="{Binding IsSettingsPage}"
                            Content="⚙" ToolTip.Tip="Settings" VerticalAlignment="Bottom"
                            Command="{Binding ShowSettingsCommand}" />
                </DockPanel>
            </Border>

            <!-- Sidebar collapsed: a slim strip whose only job is to bring it back. -->
            <Border Grid.Column="1" Grid.Row="0" Width="18" Background="{DynamicResource CyberBgPanel}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0"
                    IsVisible="{Binding WorkspaceSidebarStripVisible}">
                <Button Classes="fold" Content="›" VerticalAlignment="Top" HorizontalAlignment="Center"
                        Margin="0,6,0,0" ToolTip.Tip="Show workspaces" Command="{Binding ToggleSidebarCommand}" />
            </Border>

            <!-- Sidebar: workspaces + the active workspace's sessions. The header stays put and
                 the rest scrolls — the bottom dock (bot / code) shares this row, so a taller
                 dock leaves the sidebar less height than its lists need. -->
            <Border Grid.Column="1" Grid.Row="0" Width="220" Background="{DynamicResource CyberBgPanel}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0"
                    IsVisible="{Binding WorkspaceSidebarVisible}">
                <DockPanel Margin="0,6,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="12,2,4,2">
                        <Button DockPanel.Dock="Right" Classes="fold" Content="‹"
                                ToolTip.Tip="Hide workspaces" Command="{Binding ToggleSidebarCommand}" />
                        <Button x:Name="AddWorkspaceButton" DockPanel.Dock="Right" Classes="sidex" Content="＋"
                                FontSize="14" ToolTip.Tip="Add workspace folder" />
                        <TextBlock Text="WORKSPACES" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,6">
                    <TextBlock IsVisible="{Binding HasNoWorkspaces}"
                               Text="No workspace yet. Add a folder to open terminals in it."
                               TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextDim}" Margin="12,4" />
                    <ItemsControl ItemsSource="{Binding Workspaces}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkspaceViewModel">
                                <!-- A workspace that is a worktree of a repository another row hosts is
                                     drawn under that row (below), not here. -->
                                <StackPanel IsVisible="{Binding !IsNested}">
                                    <Border Classes="ws wsrow" Classes.selected="{Binding IsActive}" Classes.holds="{Binding HoldsActiveWorktree}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Open folder" Command="{Binding OpenFolderCommand}" />
                                                <Separator />
                                                <MenuItem Header="{Binding CopyAbsoluteHeader}" Command="{Binding CopyAbsolutePathCommand}" />
                                                <MenuItem Header="{Binding CopyRelativeHeader}" Command="{Binding CopyRelativePathCommand}"
                                                          IsVisible="{Binding HasRelativePath}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Classes="sidex" Content="✕"
                                                    ToolTip.Tip="Remove workspace" Command="{Binding RemoveCommand}" />
                                            <Button Classes="side" ToolTip.Tip="{Binding DirectoryPath}" Command="{Binding ActivateCommand}"
                                                    HorizontalContentAlignment="Stretch">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding BranchLabel}" IsVisible="{Binding HasBranchLabel}"
                                                               FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center" MaxWidth="80"
                                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextDim}" />
                                                    <TextBlock Classes="wsname" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Button>
                                        </DockPanel>
                                    </Border>
                                    <!-- The repository's other git worktrees: open ones switch, detected ones open on click. -->
                                    <ItemsControl ItemsSource="{Binding Worktrees}" IsVisible="{Binding HasWorktrees}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WorktreeEntryViewModel">
                                                <Border Classes="ws wsrow" Classes.selected="{Binding Workspace.IsActive, FallbackValue=False}" Margin="20,1,6,1">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Open worktree folder" Command="{Binding OpenFolderCommand}" />
                                                            <Separator />
                                                            <MenuItem Header="{Binding CopyAbsoluteHeader}" Command="{Binding CopyAbsolutePathCommand}" />
                                                            <MenuItem Header="{Binding CopyRelativeHeader}" Command="{Binding CopyRelativePathCommand}"
                                                                      IsVisible="{Binding HasRelativePath}" />
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Classes="sidex" Content="✕" IsVisible="{Binding IsOpened}"
                                                                ToolTip.Tip="Close this workspace (the worktree folder stays)" Command="{Binding CloseCommand}" />
                                                        <Button Classes="side" ToolTip.Tip="{Binding Tip}" Command="{Binding GoCommand}">
                                                            <!-- A DockPanel, not a horizontal StackPanel: only a bounded width lets a long branch name end in "…". -->
                                                            <DockPanel Opacity="{Binding LabelOpacity}">
                                                                <TextBlock DockPanel.Dock="Left" Text="⎇" FontSize="11" Margin="0,0,5,0" Foreground="{DynamicResource CyberTealBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Classes="wsname" Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                        </Button>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="1" Background="{DynamicResource BorderColor}" Margin="10,8" />
                    <TextBlock Text="{Binding ActiveWorkspace.DisplayName, StringFormat='SESSIONS · {0}', FallbackValue=SESSIONS}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextDim}" Margin="12,4" />
                    <ItemsControl ItemsSource="{Binding ActiveWorkspace.Tabs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TerminalTabViewModel">
                                <Border Classes="ws session" Classes.selected="{Binding IsActive}">
                                    <Button Classes="side" Content="{Binding Title}" ToolTip.Tip="{Binding HealthText}"
                                            Command="{Binding ActivateCommand}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ACTIVE SESSIONS: every running terminal of every workspace, with the agent
                         state detected on its screen (the WPF SESSIONS panel). Click = go there. -->
                    <Border Height="1" Background="{DynamicResource BorderColor}" Margin="10,8" />
                    <TextBlock Text="{Binding ActiveSessionsHeader}" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextDim}" Margin="12,4" />
                    <TextBlock IsVisible="{Binding HasNoActiveSessions}"
                               Text="No terminal is running yet." FontSize="11"
                               Foreground="{DynamicResource TextDim}" Margin="12,2" />
                        <ItemsControl ItemsSource="{Binding ActiveSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ActiveSessionItem">
                                    <Border Classes="ws session" Classes.selected="{Binding IsActive}">
                                        <Button Classes="side" Command="{Binding GoCommand}" ToolTip.Tip="{Binding Tip}"
                                                HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="1">
                                                <DockPanel>
                                                    <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,0,7,0"
                                                             VerticalAlignment="Center" Fill="{Binding StateBrush}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StateLabel}" FontSize="9"
                                                               FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                                                               Foreground="{Binding StateBrush}" VerticalAlignment="Center"
                                                               Margin="6,0,0,0" IsVisible="{Binding HasStateLabel}"
                                                               FontWeight="{Binding NeedsAttention, Converter={x:Static vm:AttentionWeight.Instance}}" />
                                                    <TextBlock Classes="title" Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Workspace}" FontSize="9" Opacity="0.7" Margin="14,0,0,0"
                                                           Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Content: one page at a time. Only Terminals shows the workspace sidebar (column 1);
                 the app-wide pages hide it, so the Auto column collapses and they get its width. -->
            <Panel Grid.Column="2" Grid.Row="0">
                <views:TerminalsView IsVisible="{Binding IsTerminalsPage}" />
                <Panel IsVisible="{Binding IsSettingsPage}">
                    <views:SettingsView DataContext="{Binding Settings}" />
                </Panel>
                <Panel IsVisible="{Binding IsWearablePage}">
                    <views:WearableView DataContext="{Binding Wearable}" />
                </Panel>
                <Panel IsVisible="{Binding IsPluginsPage}">
                    <views:PluginsView DataContext="{Binding Plugins}" />
                </Panel>
                <!-- The Remote page is added from code-behind where it is compiled in (download builds only). -->
                <Panel x:Name="RemotePageHost" IsVisible="{Binding IsRemotePage}" />
            </Panel>

            <!-- AgentBot: a sibling row spanning everything but the activity bar, as in the
                 WPF host. A sibling, never an overlay — on macOS an Avalonia surface drawn
                 over the terminal's native web view is invisible, so the dock has to take
                 space rather than float above the content. -->
            <GridSplitter Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="BotSplitter"
                          Height="6" ResizeDirection="Rows"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          IsVisible="{Binding BottomDockVisible}" />
            <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="BotPane"
                    Background="{DynamicResource CyberBgPanel}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                    IsVisible="{Binding BottomDockVisible}">
                <DockPanel>
                    <!-- Tabs on the left; pane chrome (float · maximize/restore · close), acting on
                         the tab in front, on the right. -->
                    <DockPanel DockPanel.Dock="Top" Margin="4,2,4,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="1">
                            <Button Classes="chrome" Content="⧉" ToolTip.Tip="Float this tab in its own window"
                                    Command="{Binding FloatFrontTabCommand}" />
                            <Button Classes="chrome" Content="▣" ToolTip.Tip="Maximize / restore the panel"
                                    Command="{Binding ToggleBotMaximizedCommand}" />
                            <Button Classes="chrome" Content="✕" ToolTip.Tip="Close this tab"
                                    Command="{Binding CloseFrontTabCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="ptab" Classes.selected="{Binding ShowBotInDock}" Content="🤖 BOT"
                                    IsVisible="{Binding BotDockVisible}" Command="{Binding SelectBotTabCommand}" />
                            <Button Classes="ptab" Classes.selected="{Binding CodeFilesTabSelected}" Content="📄 CODE"
                                    IsVisible="{Binding CodeDockVisible}" Command="{Binding SelectCodeTabCommand}" />
                            <!-- Enabled only when git can read the workspace's history. -->
                            <Button Classes="ptab" Classes.selected="{Binding GitLogTabSelected}" Content="⎇ GIT LOG"
                                    IsVisible="{Binding CodeDockVisible}" IsEnabled="{Binding Code.GitLog.IsAvailable}"
                                    ToolTip.Tip="{Binding Code.GitLog.TabTip}" ToolTip.ShowOnDisabled="True"
                                    Command="{Binding SelectGitLogTabCommand}" />
                            <Button Classes="ptab" Classes.selected="{Binding DiffTabSelected}" Content="± DIFF"
                                    IsVisible="{Binding CodeDockVisible}" ToolTip.Tip="The workspace's changes and the AI mode's writes — review, note, send, revert"
                                    Command="{Binding SelectDiffTabCommand}" />
                        </StackPanel>
                    </DockPanel>
                    <Panel>
                        <Panel IsVisible="{Binding ShowBotInDock}">
                            <views:AgentBotView DataContext="{Binding Bot}" />
                        </Panel>
                        <Panel IsVisible="{Binding ShowCodeInDock}">
                            <views:CodeView DataContext="{Binding Code}" />
                        </Panel>
                    </Panel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="1" Background="{DynamicResource CyberBgToolbar}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource CyberTealBrush}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextDim}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding BotStatus}" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextDim}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Month-to-date agent spend (Settings → Budget); amber near the cap, red over it. -->
                    <Button Command="{Binding OpenBudgetCommand}" Background="Transparent" BorderThickness="0"
                            Padding="4,0" Cursor="Hand" IsVisible="{Binding Settings.Budget.ChipText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            ToolTip.Tip="{Binding Settings.Budget.SpendText}">
                        <TextBlock Text="{Binding Settings.Budget.ChipText}" FontSize="11" Foreground="{Binding Settings.Budget.SpendBrush}" />
                    </Button>
                    <TextBlock Text="{Binding VersionLabel}" FontSize="11"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextDim}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
