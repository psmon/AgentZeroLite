<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgentZeroAvalonia.ViewModels"
        xmlns:views="using:AgentZeroAvalonia.Views"
        x:Class="AgentZeroAvalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1180" Height="760" MinWidth="820" MinHeight="520"
        Background="{DynamicResource CyberBgDeep}"
        Title="AgentZero Lite">

    <Window.Styles>
        <Style Selector="Border.ws">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Border.ws.selected">
            <Setter Property="Background" Value="{DynamicResource CyberBgDeep}" />
        </Style>
        <Style Selector="Button.side">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        </Style>
        <Style Selector="Border.ws.selected Button.side">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.sidex">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.sidex:pointerover">
            <Setter Property="Foreground" Value="#f14c4c" />
        </Style>
    </Window.Styles>

    <!-- The WPF MainWindow's frame: activity bar (48) · sidebar · content · status bar. -->
    <Grid RowDefinitions="*,24">

        <Grid Grid.Row="0" ColumnDefinitions="48,Auto,*,Auto">

            <!-- Activity bar -->
            <Border Grid.Column="0" Background="{DynamicResource CyberBgPanel}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Button Classes="activity" Classes.selected="{Binding IsTerminalsPage}"
                                Content="▣" ToolTip.Tip="Terminals" Command="{Binding ShowTerminalsCommand}" />
                        <Button Classes="activity" Classes.selected="{Binding BotVisible}"
                                Content="🤖" ToolTip.Tip="AgentBot" Command="{Binding ToggleBotCommand}" />
                        <Button Classes="activity" Content="▤" ToolTip.Tip="Toggle sidebar"
                                Command="{Binding ToggleSidebarCommand}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Classes="activity" Classes.selected="{Binding IsSettingsPage}"
                            Content="⚙" ToolTip.Tip="Settings" VerticalAlignment="Bottom"
                            Command="{Binding ShowSettingsCommand}" />
                </DockPanel>
            </Border>

            <!-- Sidebar: workspaces + the active workspace's sessions -->
            <Border Grid.Column="1" Width="220" Background="{DynamicResource CyberBgPanel}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0"
                    IsVisible="{Binding SidebarExpanded}">
                <DockPanel Margin="0,6">
                    <DockPanel DockPanel.Dock="Top" Margin="12,2,6,2">
                        <Button x:Name="AddWorkspaceButton" DockPanel.Dock="Right" Classes="sidex" Content="＋"
                                FontSize="14" ToolTip.Tip="Add workspace folder" />
                        <TextBlock Text="WORKSPACES" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" IsVisible="{Binding HasNoWorkspaces}"
                               Text="No workspace yet. Add a folder to open terminals in it."
                               TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextDim}" Margin="12,4" />
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Workspaces}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkspaceViewModel">
                                <Border Classes="ws" Classes.selected="{Binding IsActive}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Classes="sidex" Content="✕"
                                                ToolTip.Tip="Remove workspace" Command="{Binding RemoveCommand}" />
                                        <Button Classes="side" Content="{Binding DisplayName}"
                                                ToolTip.Tip="{Binding DirectoryPath}" Command="{Binding ActivateCommand}" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderColor}" Margin="10,8" />
                    <TextBlock DockPanel.Dock="Top" Text="SESSIONS" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextDim}" Margin="12,4" />
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding ActiveWorkspace.Tabs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TerminalTabViewModel">
                                <Border Classes="ws" Classes.selected="{Binding IsActive}">
                                    <Button Classes="side" Content="{Binding Title}" ToolTip.Tip="{Binding HealthText}"
                                            Command="{Binding ActivateCommand}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Panel />
                </DockPanel>
            </Border>

            <!-- Content: one page at a time -->
            <Panel Grid.Column="2">
                <views:TerminalsView IsVisible="{Binding IsTerminalsPage}" />
                <Border IsVisible="{Binding IsSettingsPage}" Background="{DynamicResource CyberBgDeep}" Padding="16">
                    <TextBlock Text="Settings (M0038)" FontSize="14" Foreground="{DynamicResource TextPrimary}" />
                </Border>
            </Panel>

            <!-- AgentBot pane (right dock) -->
            <Border Grid.Column="3" Width="360" Background="{DynamicResource CyberBgPanel}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,0,0"
                    IsVisible="{Binding BotVisible}">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" Text="AGENTBOT" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextDim}" />
                    <TextBlock Text="Chat + agent loop land in M0037." TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextDim}" Margin="0,6" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="1" Background="{DynamicResource CyberBgToolbar}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource CyberTealBrush}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextDim}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding BotStatus}" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextDim}" />
                <TextBlock Grid.Column="2" Text="{Binding VersionLabel}" FontSize="11"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextDim}" />
            </Grid>
        </Border>
    </Grid>
</Window>
