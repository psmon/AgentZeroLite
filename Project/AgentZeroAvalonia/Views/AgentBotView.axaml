<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgentZeroAvalonia.ViewModels"
             xmlns:views="using:AgentZeroAvalonia.Views"
             xmlns:agents="using:Agent.Common.Agents"
             x:Class="AgentZeroAvalonia.Views.AgentBotView"
             x:DataType="vm:AgentBotViewModel">

    <UserControl.Styles>
        <Style Selector="Border.bubble">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Background" Value="{DynamicResource CyberBgDeep}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.bubble.user">
            <Setter Property="Background" Value="#1f2a3a" />
            <Setter Property="BorderBrush" Value="#2f4f7f" />
            <Setter Property="Margin" Value="24,3,0,3" />
        </Style>
        <Style Selector="Border.bubble.bot">
            <Setter Property="Margin" Value="0,3,24,3" />
        </Style>
        <Style Selector="Border.bubble.system">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style Selector="Border.bubble.tool">
            <Setter Property="Background" Value="#1a2420" />
            <Setter Property="BorderBrush" Value="#2f5f4f" />
        </Style>
        <Style Selector="Border.bubble.progress">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource CyberCyanBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="TextBlock.body">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Border.bubble.system TextBlock.body">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        </Style>
        <Style Selector="TextBlock.detail">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="Button.mode">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinWidth" Value="44" />
        </Style>
        <Style Selector="Button.mic">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style Selector="Button.mic.live">
            <Setter Property="Background" Value="#3A1F7A3A" />
            <Setter Property="BorderBrush" Value="#4CAF50" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.small">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        </Style>

        <!-- M0041 -->
        <Style Selector="Border.bubble.termout">
            <Setter Property="Background" Value="#1f2a3a" />
            <Setter Property="BorderBrush" Value="{DynamicResource CyberCyanBrush}" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="Margin" Value="12,3,0,3" />
        </Style>
        <Style Selector="Border.bubble.termin">
            <Setter Property="Background" Value="#1a2420" />
            <Setter Property="BorderBrush" Value="{DynamicResource CyberTealBrush}" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="Margin" Value="0,3,12,3" />
        </Style>
        <Style Selector="Border.bubble.url">
            <Setter Property="Background" Value="#1a2b2b" />
            <Setter Property="BorderBrush" Value="{DynamicResource CyberTealBrush}" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
        </Style>
        <Style Selector="Border.optionsbar">
            <Setter Property="Background" Value="{DynamicResource CyberBgToolbar}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="Border.attachtag">
            <Setter Property="Background" Value="{DynamicResource CyberBgToolbar}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style Selector="Border.toast">
            <Setter Property="Background" Value="{DynamicResource CyberBgToolbar}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CyberCyanBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="Button.minikey">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="26" />
        </Style>
        <Style Selector="Button.chip">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource CyberYellowBrush}" />
        </Style>
        <Style Selector="Button.linkbtn">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource CyberTealBrush}" />
        </Style>
        <Style Selector="Button.report">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        </Style>
        <Style Selector="Thumb.inputresize">
            <Setter Property="Background" Value="{DynamicResource BorderColor}" />
            <Setter Property="Cursor" Value="SizeNorthSouth" />
        </Style>
        <Style Selector="TextBlock.sessiongroup">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource CyberCyanBrush}" />
        </Style>
        <Style Selector="TextBlock.sessiontab">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource CyberMagentaBrush}" />
        </Style>
        <Style Selector="SelectableTextBlock.body">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Border.bubble.system SelectableTextBlock.body">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        </Style>
        <Style Selector="SelectableTextBlock.detail">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- ── Transcript cards (A2UI-style components; see Agents/BotCards) ──
             Reading size for what a person or an agent SAID, a smaller one for tool and
             reference rows; a capped line length, because the pane is often 2,000 px wide. -->
        <Style Selector="Border.bubble">
            <Setter Property="MaxWidth" Value="980" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.bubble.user">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="Border.bubble.system, Border.bubble.progress">
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style Selector="Border.bubble.failed">
            <Setter Property="BorderBrush" Value="#B05A5A" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBlock.label.headline">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="MaxWidth" Value="620" />
        </Style>
        <Style Selector="TextBlock.label.failedtag">
            <Setter Property="Foreground" Value="#E57373" />
        </Style>

        <Style Selector="SelectableTextBlock.node">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style Selector="Border.bubble.speech SelectableTextBlock.node">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="22" />
        </Style>
        <Style Selector="SelectableTextBlock.node.heading">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
        <Style Selector="Border.bubble.speech SelectableTextBlock.node.heading">
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="SelectableTextBlock.node.caption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style Selector="Border.bubble.speech SelectableTextBlock.node.caption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="16" />
        </Style>
        <Style Selector="SelectableTextBlock.node.listmarker">
            <Setter Property="Margin" Value="6,2,8,2" />
            <Setter Property="MinWidth" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        </Style>
        <Style Selector="Border.quotebar">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Padding" Value="8,0,0,0" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style Selector="Border.codebox">
            <Setter Property="Background" Value="#14181F" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style Selector="SelectableTextBlock.code">
            <Setter Property="FontFamily" Value="JetBrains Mono, Cascadia Mono, Consolas, Menlo, monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.fieldlabel">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Margin" Value="0,2,10,2" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="SelectableTextBlock.fieldvalue">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style Selector="Border.nodedivider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource BorderColor}" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <Style Selector="ToggleButton.fold">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="MaxWidth" Value="900" />
        </Style>
        <Style Selector="SelectableTextBlock.body">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="LineHeight" Value="18" />
        </Style>
    </UserControl.Styles>

    <!-- The component catalog: one template per node type (Agents/BotCards). -->
    <UserControl.DataTemplates>
        <DataTemplate DataType="agents:BotText">
            <Panel>
                <SelectableTextBlock Classes="node" Text="{Binding Text}"
                                     Classes.heading="{Binding IsHeading}" Classes.caption="{Binding IsCaption}"
                                     IsVisible="{Binding IsProse}" />
                <Border Classes="codebox" IsVisible="{Binding IsCode}">
                    <SelectableTextBlock Classes="code" Text="{Binding Text}" />
                </Border>
            </Panel>
        </DataTemplate>
        <DataTemplate DataType="agents:BotField">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Classes="fieldlabel" Text="{Binding Label}" />
                <SelectableTextBlock Grid.Column="1" Classes="fieldvalue" Text="{Binding Value}" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="agents:BotList">
            <!-- Marker and text in two columns: a wrapped item hangs under its own text. -->
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="agents:BotListRow">
                        <Grid ColumnDefinitions="Auto,*">
                            <SelectableTextBlock Classes="node listmarker" Text="{Binding Marker}" />
                            <SelectableTextBlock Grid.Column="1" Classes="node" Text="{Binding Text}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate DataType="agents:BotDivider">
            <Border Classes="nodedivider" />
        </DataTemplate>
    </UserControl.DataTemplates>

    <DockPanel Margin="8">
        <!-- Header: session (group / tab) + options toggle + AI controls -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                <Button Classes="small" Content="↻" ToolTip.Tip="New session (reset agent memory)"
                        Command="{Binding NewSessionCommand}" IsVisible="{Binding IsAiMode}" />
                <Button Classes="small" Content="■" ToolTip.Tip="Cancel the running turn"
                        Command="{Binding CancelCommand}" IsVisible="{Binding AiBusy}" />
                <Button Classes="small" Content="⋯" ToolTip.Tip="Toggle options"
                        Command="{Binding ToggleOptionsCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="AGENTBOT" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding HasSession}">
                    <TextBlock Text="·" Classes="label" VerticalAlignment="Center" />
                    <TextBlock Classes="sessiongroup" Text="{Binding SessionGroup}" VerticalAlignment="Center" />
                    <TextBlock Text="/" Classes="label" VerticalAlignment="Center" />
                    <TextBlock Classes="sessiontab" Text="{Binding SessionTab}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Options bar (collapsible) -->
        <Border DockPanel.Dock="Top" Classes="optionsbar" IsVisible="{Binding OptionsExpanded}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Auto-approve delay" Classes="label" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Text="{Binding AutoApproveDelayText}" Width="34" FontSize="11"
                         ToolTip.Tip="Seconds to wait before answering (0–30, 0 = at once)" Margin="0,0,10,0" />
                <CheckBox IsChecked="{Binding AutoApprove}" Content="Auto" FontSize="11" Margin="0,0,10,0"
                          ToolTip.Tip="Answer terminal approval prompts automatically" />
                <CheckBox IsChecked="{Binding HideSystemMessages}" Content="Hide notices" FontSize="11"
                          ToolTip.Tip="Keep auto-approve lines, session banners and timings out of the chat" />
            </WrapPanel>
        </Border>

        <!-- Composer -->
        <Border DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Left" Classes="mode" Content="{Binding ModeLabel}"
                        ToolTip.Tip="Cycle mode: CHT → KEY → AI (Shift+Tab)"
                        Command="{Binding CycleModeCommand}" Margin="0,0,6,0" />
                <Button DockPanel.Dock="Right" Content="➤" Padding="8,3"
                        Command="{Binding SendCommand}" Margin="6,0,0,0" />
                <Button DockPanel.Dock="Right" Classes="mic" Classes.live="{Binding MicOn}" Content="🎙"
                        Command="{Binding ToggleMicCommand}" IsVisible="{Binding MicSupported}"
                        ToolTip.Tip="{Binding MicTip}" Margin="6,0,0,0" />
                <TextBox x:Name="InputBox" Text="{Binding Input}"
                         Watermark="Message… (Enter to send, Shift+Enter for a new line)"
                         AcceptsReturn="True" TextWrapping="Wrap" FontSize="12"
                         MaxHeight="{Binding InputMaxHeight}" VerticalContentAlignment="Top" />
            </DockPanel>
        </Border>

        <!-- Mini key pad -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <Button DockPanel.Dock="Left" Classes="small" Content="⌨" ToolTip.Tip="Toggle key buttons"
                    Command="{Binding ToggleMiniKeysCommand}" />
            <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding MiniKeysExpanded}">
                <Button Classes="minikey" Content="◀" ToolTip.Tip="Left"  Command="{Binding SendMiniKeyCommand}" CommandParameter="left" />
                <Button Classes="minikey" Content="▲" ToolTip.Tip="Up"    Command="{Binding SendMiniKeyCommand}" CommandParameter="up" />
                <Button Classes="minikey" Content="▼" ToolTip.Tip="Down"  Command="{Binding SendMiniKeyCommand}" CommandParameter="down" />
                <Button Classes="minikey" Content="▶" ToolTip.Tip="Right" Command="{Binding SendMiniKeyCommand}" CommandParameter="right" />
                <Button Classes="minikey" Content="⏎" ToolTip.Tip="Enter" Command="{Binding SendMiniKeyCommand}" CommandParameter="enter" />
                <Button Classes="minikey" Content="⇥" ToolTip.Tip="Tab"   Command="{Binding SendMiniKeyCommand}" CommandParameter="tab" />
                <Button Classes="minikey" Content="esc" ToolTip.Tip="Escape" Command="{Binding SendMiniKeyCommand}" CommandParameter="esc" />
            </StackPanel>
        </DockPanel>

        <!-- Clipboard attachment chip -->
        <Border DockPanel.Dock="Bottom" Classes="attachtag" Margin="0,4,0,0"
                IsVisible="{Binding AttachmentTag, Converter={x:Static ObjectConverters.IsNotNull}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Classes="small" Content="✕" ToolTip.Tip="Remove the attachment"
                        Command="{Binding ClearAttachmentCommand}" />
                <Button Classes="chip" Command="{Binding PreviewAttachmentCommand}"
                        ToolTip.Tip="Show a preview in the chat"
                        Content="{Binding AttachmentTag}" />
            </DockPanel>
        </Border>

        <!-- Input resize grip: drag up to make the composer taller -->
        <Thumb DockPanel.Dock="Bottom" Classes="inputresize" Height="5" Margin="0,4,0,0"
               DragDelta="OnInputResize" />

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusLine}" FontSize="10"
                   Foreground="{DynamicResource TextDim}" Margin="0,4,0,0" />

        <!-- Transcript, with the toasts over it. Both overlay Avalonia content only —
             the terminal's native web view lives in TerminalsView, never under this pane. -->
        <Panel>
            <ScrollViewer x:Name="Transcript" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatItem">
                            <!-- One card per entry. Its body is a list of components (Agents/BotCards,
                                 after A2UI) drawn by the node templates above; notices, the progress
                                 row and links keep their single line of text. -->
                            <Border Classes="bubble"
                                    Classes.user="{Binding IsUser}" Classes.bot="{Binding IsBot}"
                                    Classes.system="{Binding IsSystem}" Classes.tool="{Binding IsTool}"
                                    Classes.progress="{Binding IsProgress}"
                                    Classes.termout="{Binding IsTerminalOut}" Classes.termin="{Binding IsTerminalIn}"
                                    Classes.url="{Binding IsUrl}" Classes.speech="{Binding IsSpeech}"
                                    Classes.failed="{Binding Failed}">
                                <StackPanel>
                                    <DockPanel IsVisible="{Binding !IsSystem}">
                                        <TextBlock DockPanel.Dock="Right" Classes="label" Text="{Binding TimeLabel}" Margin="12,0,0,2" />
                                        <Button DockPanel.Dock="Right" Classes="report" Content="⚑ Report"
                                                IsVisible="{Binding CanReport}"
                                                ToolTip.Tip="Report this AI answer (inappropriate, harmful or wrong)"
                                                AutomationProperties.Name="Report this AI answer"
                                                Command="{Binding $parent[ItemsControl].((vm:AgentBotViewModel)DataContext).ReportAnswerCommand}"
                                                CommandParameter="{Binding}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Classes="label" Text="{Binding Label}" />
                                            <TextBlock Classes="label headline" Text="{Binding Headline}"
                                                       IsVisible="{Binding HasHeadline}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="label failedtag" Text="FAILED" IsVisible="{Binding Failed}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Nodes}" IsVisible="{Binding HasNodes}" />
                                    <SelectableTextBlock Classes="body" Text="{Binding Text}"
                                                         IsVisible="{Binding ShowText}" />
                                    <Button Classes="linkbtn" Content="{Binding Text}" IsVisible="{Binding IsUrl}"
                                            ToolTip.Tip="Open in the browser"
                                            Command="{Binding $parent[ItemsControl].((vm:AgentBotViewModel)DataContext).OpenLinkCommand}"
                                            CommandParameter="{Binding}" />
                                    <StackPanel IsVisible="{Binding HasDetailNodes}">
                                        <ToggleButton Classes="fold" IsChecked="{Binding DetailOpen}"
                                                      Content="{Binding DetailHeader}"
                                                      ToolTip.Tip="Show / hide" />
                                        <ItemsControl ItemsSource="{Binding DetailNodes}"
                                                      IsVisible="{Binding DetailOpen}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Mode toast -->
            <Border Classes="toast" HorizontalAlignment="Center" VerticalAlignment="Top" ZIndex="99"
                    IsVisible="{Binding ModeToast, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding ModeToast}" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource CyberCyanBrush}" />
            </Border>

            <!-- Report-an-answer panel (Microsoft Store policy 11.16) -->
            <!-- Fills the transcript area and scrolls, so a short bot pane never pushes it over the composer. -->
            <Border Classes="toast" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="101"
                    Margin="0" Padding="10,8" ClipToBounds="True" IsVisible="{Binding Report.IsOpen}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="6" DataContext="{Binding Report}" x:DataType="vm:AiReportViewModel">
                    <!-- The actions sit on the title row so they are visible in the shortest bot pane. -->
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                            <Button Content="Send by e-mail" FontSize="11" Command="{Binding SendEmailCommand}" />
                            <Button Content="Open GitHub issue" FontSize="11" Command="{Binding OpenIssueCommand}" />
                            <Button Content="Cancel" FontSize="11" Command="{Binding CancelCommand}" />
                        </StackPanel>
                        <TextBlock Text="REPORT THIS AI ANSWER" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource CyberCyanBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Preview}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextDim}" />
                    <ComboBox ItemsSource="{Binding CategoryNames}" SelectedIndex="{Binding CategoryIndex}"
                              FontSize="11" HorizontalAlignment="Stretch" />
                    <TextBox Text="{Binding Note}" PlaceholderText="What is wrong with it? (optional)"
                             AcceptsReturn="True" TextWrapping="Wrap" FontSize="11" MinHeight="32" MaxHeight="100" />
                    <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}"
                               Text="Opens a pre-filled e-mail or GitHub issue with this answer quoted. Nothing is sent until you send it." />
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Approval toast -->
            <Panel HorizontalAlignment="Stretch" VerticalAlignment="Top" ZIndex="100"
                   IsVisible="{Binding Approval.IsOpen}">
                <views:ApprovalToast DataContext="{Binding Approval}" />
            </Panel>
        </Panel>
    </DockPanel>
</UserControl>
