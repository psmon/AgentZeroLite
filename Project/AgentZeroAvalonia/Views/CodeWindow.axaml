<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgentZeroAvalonia.ViewModels"
        xmlns:views="using:AgentZeroAvalonia.Views"
        x:Class="AgentZeroAvalonia.Views.CodeWindow"
        x:DataType="vm:CodeViewModel"
        Title="{Binding RootName, StringFormat='Code — {0}'}"
        Icon="avares://AgentZeroLite/Assets/agentzero.ico"
        Width="1000" Height="640" MinWidth="480" MinHeight="240"
        Background="#1E1E1E"
        WindowStartupLocation="Manual">

    <!-- The code view as its own window — a side window like a detached terminal or plugin:
         no owner (an owned window stayed on top of the main window and read as a dialog), and
         the way back is a button in the strip, not only the close box. No state here: the
         DataContext is the same CodeViewModel the docked tab uses. -->
    <Window.Styles>
        <!-- MainWindow's panel-tab look (its styles are window-local). -->
        <Style Selector="Button.ptab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        </Style>
        <Style Selector="Button.ptab.selected">
            <Setter Property="Foreground" Value="{DynamicResource CyberCyanBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CyberCyanBrush}" />
        </Style>
        <Style Selector="Button.ptab:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Button.ptab:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- The dock's CODE | GIT LOG | DIFF tabs, for when the panel floats; pin and the way
             back on the right (the detached terminal's and plugin's strip). -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource CyberBgToolbar}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" Margin="0,0,6,0">
                    <ToggleButton x:Name="PinButton" Content="📌" Padding="6,2" FontSize="11"
                                  ToolTip.Tip="Always on top — keep it beside your terminals" />
                    <Button x:Name="DockBackButton" Content="↩ Dock back" Padding="8,2" FontSize="11"
                            Foreground="{DynamicResource CyberCyanBrush}"
                            ToolTip.Tip="Return the code view to the bottom panel (closing the window does the same)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="2" Margin="4,2">
                    <Button Classes="ptab" Classes.selected="{Binding ShowFilesPane}" Content="📄 CODE"
                            Command="{Binding ShowFilesCommand}" />
                    <Button Classes="ptab" Classes.selected="{Binding ShowGitLog}" Content="⎇ GIT LOG"
                            IsEnabled="{Binding GitLog.IsAvailable}" ToolTip.Tip="{Binding GitLog.TabTip}"
                            ToolTip.ShowOnDisabled="True" Command="{Binding ShowHistoryCommand}" />
                    <Button Classes="ptab" Classes.selected="{Binding ShowDiff}" Content="± DIFF"
                            Command="{Binding ShowChangesCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <views:CodeView />
    </DockPanel>
</Window>
