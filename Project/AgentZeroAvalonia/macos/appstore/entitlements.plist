<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac App Store build (App Sandbox). build-appstore.sh adds the two identifiers below from
     the provisioning profile. Why each entry is here: Docs/avalonia-v2/macos-distribution.md §4. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.application-identifier</key>
    <string>HA39FQRUZG.com.psmon.agentzerolite</string>
    <key>com.apple.developer.team-identifier</key>
    <string>HA39FQRUZG</string>

    <!-- The .NET runtime JIT-compiles. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Loopback servers (xterm renderer, plugins), External LLM providers, web tools. -->
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Workspace folders the person picks with the folder dialog. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Workspace folders stay reachable across launches through security-scoped bookmarks
         (SandboxFolderAccess). A terminal tab is a child process and inherits the access. -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>

    <!-- The person's own Homebrew installation, so a tab can start node and the CLIs they
         installed. App Review refused the home-wide and /usr/local/ exceptions (2.4.5(i),
         2026-10-28) and did not object to this one. -->
    <key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
    <array>
        <string>/opt/homebrew/</string>
    </array>
</dict>
</plist>
